# Copy this file to `.env` and fill in real values. `.env` is gitignored —
# never commit real keys. All variables below have working defaults except
# API_TOKEN (required to access the API) and provider keys (needed only for
# the corresponding LLM_PROVIDER choice).

# --- API security -----------------------------------------------------------
# Bearer token required for all data routes (GET/POST/DELETE /resumes/*,
# /prompts/*, /reviews/*, /review-rules*). GET /health stays public.
API_TOKEN=your-api-token-here
# Comma-separated list of browser origins allowed by CORS. Empty = no
# cross-origin browser access (same-origin web UI still works).
CORS_ORIGINS=http://localhost:8000

# --- Upload limits (bytes / counts) -----------------------------------------
MAX_UPLOAD_BYTES=52428800
MAX_RESULT_JSON_BYTES=10485760
MAX_PDF_BYTES=26214400
MAX_PDF_FILES_PER_UPLOAD=50

# --- Qdrant -----------------------------------------------------------------
QDRANT_URL=https://your-cluster.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key-here
# true/1/yes to verify TLS with certifi; default false
QDRANT_VERIFY_SSL=false

# --- LLM provider -----------------------------------------------------------
# ollama (default, local) | openai (Groq via OpenAI SDK) | openrouter or official_openai (OpenRouter)
LLM_PROVIDER=ollama

# Ollama (local)
OLLAMA_MODEL_NAME=llama3.2:3b
OLLAMA_NUM_GPU=0

# Groq (used when LLM_PROVIDER=openai and GROQ_API_KEY is set)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=qwen/qwen3.8-27b

# OpenRouter (used when LLM_PROVIDER is openrouter/official_openai and OPEN_ROUTER_KEY is set)
OPEN_ROUTER_KEY=your-openrouter-key-here
OPENROUTER_MODEL=openrouter/auto

# --- CV parsing provider (about / feedback extraction) ----------------------
# openrouter (free models first, default) | ollama | openai (Groq)
PARSING_PROVIDER=openrouter
# Concrete free model for parsing; ignored when PARSING_PROVIDER=ollama
PARSING_MODEL=openrouter/auto

# --- LLM rate limiting (cloud providers only) -------------------------------
LLM_MAX_OUTPUT_TOKENS=300
LLM_TPM_LIMIT=1000
LLM_TPM_SAFETY=0.90

# --- Parser -----------------------------------------------------------------
# Base URL used by extract/parser.py when calling the API for batch processing
API_BASE_URL=http://127.0.0.1:8000